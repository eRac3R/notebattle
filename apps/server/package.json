{
  "name": "@notebattle/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@notebattle/engine": "workspace:*",
    "@notebattle/protocol": "workspace:*",
    "@notebattle/quizgen": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
