# Copy to apps/server/.env.local for local dev (git-ignored). Real env vars always win.
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Postgres (Neon pooled URL in production). Unset => in-memory store, no DB needed.
# DATABASE_URL=postgres://notebattle:notebattle@localhost:5434/notebattle

# Any OpenAI-compatible provider. Unset => $0 offline generator.
# Groq free tier (hosted default):
# NOTEBATTLE_LLM_BASE_URL=https://api.groq.com/openai/v1
# NOTEBATTLE_LLM_MODEL=openai/gpt-oss-120b
# NOTEBATTLE_LLM_API_KEY=
# Local Ollama (no key):
# NOTEBATTLE_LLM_BASE_URL=http://localhost:11434/v1
# NOTEBATTLE_LLM_MODEL=llama3.2
# Force offline even if the above are set:
# NOTEBATTLE_LLM_MODE=offline
